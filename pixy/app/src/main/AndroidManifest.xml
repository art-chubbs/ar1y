<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Floating pill (Display over other apps). Granted by the user in Settings. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Only for the optional "order notifications" setting; requested when you turn it on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets Android 16 show that optional notification as a Live Update (normal permission, no prompt). -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- No INTERNET permission: the app cannot send anything off the phone. -->

    <queries>
        <!-- Package visibility: icons/labels and launch intents for the supported delivery apps. -->
        <package android:name="in.swiggy.android" />
        <package android:name="in.swiggy.android.instamart" />
        <package android:name="com.application.zomato" />
        <package android:name="com.grofers.customerapp" />
        <package android:name="com.bigbasket.mobileapp" />
        <!-- Lets you pick any other launcher app to track from Settings -> Supported apps. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".PixyApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pixy"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="36">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Bound by the system while Notification access is granted. Conversations are excluded. -->
        <service
            android:name=".notifications.OrderListenerService"
            android:exported="true"
            android:label="@string/listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="alerting|silent|ongoing" />
            <meta-data
                android:name="android.service.notification.disabled_filter_types"
                android:value="conversations" />
        </service>
    </application>
</manifest>
